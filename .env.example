# Local development; production must use https://your-domain and COOKIE Secure is automatic.
APP_ORIGIN=http://127.0.0.1:8015
DATA_DIR=./data/lesson2
ALLOW_REGISTRATION=true
# Empty AI credentials disable AI without affecting other features.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
# Output budget includes reasoning tokens. OpenRouter reasoning effort; blank uses provider defaults.
AI_MAX_TOKENS=8192
AI_REASONING_EFFORT=low
# OpenRouter only: prefer higher output throughput while retaining structured-output support.
AI_PROVIDER_SORT=throughput
CLASSROOM_CODE=BIO-LESSON2
# Required for teacher access; use a private random password.
CLASSROOM_TEACHER_PASSWORD=
# Local SQLite is automatic. Docker Compose overrides DATABASE_URL.
# DATABASE_URL=postgresql+psycopg://workbench:password@localhost:5432/workbench
# 单个应用进程的连接池：最多 20 + 10 = 30 个，按需建立连接。
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# Production uses the existing domain and /lesson path; local development stays unprefixed.
COMPOSE_PROJECT_NAME=edu-lesson2
DOMAIN=lsclass.top
APP_BASE_PATH=
POSTGRES_PASSWORD=

# Speech: blank URL/key reuse AI settings. Audio is transient, transcripts join classroom records.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=qwen/qwen3-asr-0.6b
# Verify the configured model with real audio before deployment; availability can change.
