# Local development; production must use https://your-domain and COOKIE Secure is automatic.
APP_ORIGIN=http://127.0.0.1:8000
ALLOW_REGISTRATION=true
# Empty AI credentials disable AI without affecting other features.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Local SQLite is automatic. Docker Compose overrides DATABASE_URL.
# DATABASE_URL=postgresql+psycopg://workbench:password@localhost:5432/workbench
# DATA_DIR=./data
# Required only for Docker Compose; choose your domain and a long random hex password.
DOMAIN=your-domain.example
POSTGRES_PASSWORD=
