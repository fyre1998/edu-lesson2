# Import this snippet inside the existing lsclass.top site block.
# It adds only /lesson paths, preserving the first lesson's existing handlers.
redir /lesson /lesson/ 308
redir /lesson/workspace /lesson/workspace/ 308
redir /lesson/classroom /lesson/classroom/ 308
handle_path /lesson/* {
    request_body {
        max_size 21MB
    }
    reverse_proxy edu-lesson2-app:8000
}
